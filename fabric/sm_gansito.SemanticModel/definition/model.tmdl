model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - lh_gold"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","RemoteModeling","DaxQueryView_Desktop"]

ref table dim_tienda
ref table dim_mes
ref table dim_producto
ref table hechos_relativos
ref table hechos_precios
ref table hechos_salario_mensual
ref table dim_tiempo_quincena
ref table 'Umbral de pareo'
ref table Medidas

